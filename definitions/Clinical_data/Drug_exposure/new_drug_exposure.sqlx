

config {
  type: "view"
}

/* ---------- Utilidades ---------- */
with system_to_vocab as (
  select 'http://www.nlm.nih.gov/research/umls/rxnorm' as system, 'RxNorm' as vocabulary_id union all
  select 'http://www.whocc.no/atc'                      , 'ATC'                union all
  select 'http://snomed.info/sct'                       , 'SNOMED'             union all
  select 'http://hl7.org/fhir/sid/ndc'                  , 'NDC'
),

/* ---------- Origen MedicationRequest (estructura ya parseada) ---------- */
mr as (
  select
    id                                                      as mr_id,
    fhir.status                                             as mr_status,
    fhir.authoredOn                                         as authored_on_str,
    fhir.subject.reference                                  as subject_ref,
    fhir.encounter.reference                                as encounter_ref,
    fhir.requester.reference                                as requester_ref,

    -- Dispense
    fhir.dispenseRequest.numberOfRepeatsAllowed             as repeats_allowed,
    fhir.dispenseRequest.quantity.value                     as qty_value_str,
    fhir.dispenseRequest.quantity.unit                      as qty_unit,
    fhir.dispenseRequest.expectedSupplyDuration.value       as dur_value,
    fhir.dispenseRequest.expectedSupplyDuration.unit        as dur_unit,
    fhir.dispenseRequest.validityPeriod.start               as validity_start_str,
    fhir.dispenseRequest.validityPeriod.end                 as validity_end_str,

    -- Medication codings (array)
    fhir.medicationCodeableConcept.coding                   as med_codings,

    -- DosageInstruction (array)
    fhir.dosageInstruction                                  as dosage_arr
  from `healthtree-production.HT_test_sync.apps-curehub-medicalResources-r4-MedicationRequest`
),

/* ---------- Primera dosageInstruction + route ---------- */
mr_di as (
  select
    m.*,
    di,
    di.text                                                 as sig_text,
    di.route.coding                                         as route_codings
  from mr m
  left join unnest(m.dosage_arr) as di with offset dio
    on dio = 0
),

/* ---------- Normalización de codificaciones del medicamento ---------- */
med_coding_flat as (
  select
    m.*,
    mc.system as med_system,
    mc.code   as med_code,
    mc.display as med_display,
    row_number() over (
      partition by m.mr_id
      order by case when lower(mc.system) like '%rxnorm%' then 1 else 2 end, mc.code
    ) as rn
  from mr_di m
  left join unnest(m.med_codings) mc
),
mr_onecode as (
  select * from med_coding_flat where rn = 1
),

/* ---------- Route: tomar el primer coding si existe ---------- */
route_flat as (
  select
    m.*,
    rc.system as route_system,
    rc.code   as route_code,
    rc.display as route_display,
    row_number() over (partition by m.mr_id order by 1) as r_rn
  from mr_onecode m
  left join unnest(m.route_codings) rc
),
mr_with_route as (
  select * except(r_rn) from route_flat where r_rn = 1 or r_rn is null
),

/* ---------- Casting y fechas ---------- */
typed as (
  select
    *,
    SAFE_CAST(repeats_allowed AS INT64)        AS repeats_allowed_i,
SAFE_CAST(qty_value_str AS NUMERIC)        AS quantity_value,
SAFE_CAST(dur_value AS NUMERIC)            AS duration_value,
SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', authored_on_str)     AS authored_on_ts,
SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', validity_start_str)  AS validity_start_ts,
SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', validity_end_str)    AS validity_end_ts

  from mr_with_route
),

supply as (
  select
    *,
    case
      when duration_value is null then null
      when lower(dur_unit) in ('d','day','days') then duration_value
      when lower(dur_unit) in ('wk','week','weeks') then duration_value * 7
      when lower(dur_unit) in ('mo','month','months') then duration_value * 30
      when lower(dur_unit) in ('a','year','years') then duration_value * 365
      else duration_value
    end as days_supply_from_duration
  from typed
),

dates as (
  select
    *,
    coalesce(validity_start_ts, authored_on_ts) as start_ts_raw,
    coalesce(
      validity_end_ts,
      case
        when coalesce(validity_start_ts, authored_on_ts) is not null
         and days_supply_from_duration is not null
        then coalesce(validity_start_ts, authored_on_ts)
             + make_interval(0,0,0, cast(round(days_supply_from_duration) as int64))
        else null
      end
    ) as end_ts_raw
  from supply
),

/* ---------- Resolver conceptos (drug, route) ---------- */
-- RxNorm directo
rxnorm_direct as (
  select
    d.mr_id,
    c.concept_id as rx_concept_id
  from dates d
  join ${ref("concept")} c
    on c.vocabulary_id = 'RxNorm'
   and c.concept_code  = d.med_code
),
-- origen → "Maps to" estándar Drug
source_concept as (
  select
    d.mr_id,
    csrc.concept_id    as src_concept_id,
    csrc.vocabulary_id as src_vocab_id
  from dates d
  join system_to_vocab map
    on lower(d.med_system) = lower(map.system)
  join `healthtree-production.dataform.concept` csrc
    on csrc.vocabulary_id = map.vocabulary_id
   and csrc.concept_code  = d.med_code
),
maps_to_std as (
  select
    s.mr_id,
    s.src_concept_id,
    cstd.concept_id as std_concept_id
  from source_concept s
  join `healthtree-production.dataform.concept_relationship` cr
    on cr.concept_id_1 = s.src_concept_id
   and cr.relationship_id = 'Maps to'
  join `healthtree-production.dataform.concept` cstd
    on cstd.concept_id = cr.concept_id_2
   and cstd.standard_concept = 'S'
   and cstd.domain_id = 'Drug'
),
drug_res as (
  select
    d.*,
    coalesce(rd.rx_concept_id, mt.std_concept_id, 0) as drug_concept_id,
    coalesce(mt.src_concept_id, rd.rx_concept_id, 0) as drug_source_concept_id
  from dates d
  left join rxnorm_direct rd using(mr_id)
  left join maps_to_std  mt using(mr_id)
),

-- Route
route_src as (
  select
    r.*,
    rsys.vocabulary_id,
    crte.concept_id as route_source_concept_id,
    cstd.concept_id as route_concept_id
  from drug_res r
  left join system_to_vocab rsys
    on lower(r.route_system) = lower(rsys.system)
  left join `healthtree-production.dataform.concept` crte
    on rsys.vocabulary_id = crte.vocabulary_id
   and r.route_code       = crte.concept_code
  left join `healthtree-production.dataform.concept_relationship` rel
    on rel.concept_id_1   = crte.concept_id
   and rel.relationship_id = 'Maps to'
  left join `healthtree-production.dataform.concept` cstd
    on cstd.concept_id = rel.concept_id_2
   and cstd.domain_id  = 'Route'
),

/* ---------- Joins a person / provider / visit ---------- */
linked as (
  select
    r.*,
    regexp_extract(subject_ref,  r'Patient\/([^\/]+)$')   as patient_id_from_ref,
    regexp_extract(encounter_ref,r'Encounter\/([^\/]+)$') as encounter_id_from_ref
  from route_src r
),
pjoin as (
  select
    l.*,
    p.person_id
  from linked l
  left join ${ref("person")} p
    on p.person_source_value in (
      concat('Patient/', l.patient_id_from_ref),
      l.patient_id_from_ref
    )
),
provjoin as (
  select
    pj.*,
    pr.provider_id
  from pjoin pj
  left join ${ref("provider")} pr
    on pr.provider_source_value = pj.requester_ref
),
vjoin as (
  select
    prj.*,
    vo.visit_occurrence_id
  from provjoin prj
  left join ${ref("visit_occurrence")} vo
    on vo.visit_source_value in (
      concat('Encounter/', prj.encounter_id_from_ref),
      prj.encounter_id_from_ref
    )
),

/* ---------- Fechas finales y métricas ---------- */
final_prep as (
  select
    *,
    start_ts_raw as start_ts,
    case
      when end_ts_raw is not null and start_ts_raw is not null and end_ts_raw < start_ts_raw then null
      else end_ts_raw
    end as end_ts,

    cast(
      case
        when days_supply_from_duration is not null then round(days_supply_from_duration)
        when end_ts_raw is not null and start_ts_raw is not null
          then date_diff(date(end_ts_raw), date(start_ts_raw), day)
        else null
      end as int64
    ) as days_supply_i,

    quantity_value as quantity_n
  from vjoin
)

/* ---------- Salida OMOP drug_exposure ---------- */
select
  -- surrogate estable
  abs(farm_fingerprint(concat(coalesce(mr_id,''), '|', coalesce(subject_ref,''), '|', coalesce(authored_on_str,'')))) as drug_exposure_id,

  person_id,
  drug_concept_id,

  date(start_ts)                                 as drug_exposure_start_date,
  cast(start_ts as datetime)                     as drug_exposure_start_datetime,

  date(end_ts)                                   as drug_exposure_end_date,
  cast(end_ts as datetime)                       as drug_exposure_end_datetime,

  cast(null as date)                             as verbatim_end_date,

  -- MedicationRequest ⇒ "Prescription written"
  38000177                                       as drug_type_concept_id,

  case when lower(mr_status) in ('stopped','entered-in-error','cancelled') then mr_status else null end as stop_reason,

  repeats_allowed_i                               as refills,
  quantity_n                                      as quantity,
  days_supply_i                                   as days_supply,

  sig_text                                        as sig,

  coalesce(route_concept_id, 0)                   as route_concept_id,
  cast(null as string)                            as lot_number,

  provider_id,
  visit_occurrence_id,
  cast(null as int64)                             as visit_detail_id,

  -- source
  coalesce(med_display, med_code)                 as drug_source_value,
  drug_source_concept_id,
  route_display                                   as route_source_value,
  qty_unit                                        as dose_unit_source_value

from final_prep
-- where person_id is not null
 -- and drug_concept_id != 0

