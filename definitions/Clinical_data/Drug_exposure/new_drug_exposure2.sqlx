config {
  type: "view"
}

-- Staging de MedicationRequest
WITH intermediate AS (
  SELECT
    id AS keyId,
    user AS userId,
    fhir.id AS recordId,
    fhir.authoredOn,
    fhir.courseOfTherapyType.text AS courseOfTherapyType,
    fhir.medicationReference.display AS medReferenceName,
    fhir.medicationReference.reference AS medReference,
    fhir.medicationCodeableConcept.text AS text,
    cc.display AS name,
    cc.code AS code,
    cc.system AS medSystem,
    catg.text AS category,
    fhir.status,
    (
      SELECT dos
      FROM UNNEST(fhir.dosageInstruction) AS dos
      LIMIT 1
    ) AS dosageInstruction,
    fhir.encounter.reference AS visit_reference
  FROM `healthtree-production.HT_test_sync.apps-curehub-medicalResources-r4-MedicationRequest` AS MR
  LEFT JOIN UNNEST(MR.fhir.medicationCodeableConcept.coding) AS cc
  LEFT JOIN UNNEST(MR.fhir.category) AS catg
),

intermediateWithDosage AS (
  SELECT
    * EXCEPT(dosageInstruction),
    dosageInstruction.asNeededBoolean AS asNeeded,
    dosageInstruction.text AS instructions,
    dosageInstruction.route.text AS route,
    dosageInstruction.timing.repeat.boundsPeriod.start AS start,
    dosageInstruction.timing.repeat.boundsPeriod.end AS endt,
    dosageInstruction.timing.repeat.frequency,
    dosageInstruction.timing.repeat.period,
    dosageInstruction.timing.repeat.periodUnit,
    dosageInstruction.patientInstruction,
    dosageInstruction.doseAndRate[SAFE_OFFSET(0)].doseQuantity.value AS doseValue,
    dosageInstruction.doseAndRate[SAFE_OFFSET(0)].doseQuantity.unit AS doseUnit,
    dosageInstruction.doseAndRate[SAFE_OFFSET(0)].type.text AS doseType
  FROM intermediate
),

-- Deriva RXCUI directamente de MedicationRequest si el system es RxNorm
-- (Si no hay RxNorm, RXCUI quedará NULL; puedes seguir usando 'code' y 'medSystem' como fuente)
intermediateNoMapping AS (
  SELECT
    iwd.*,
    CASE
      WHEN LOWER(iwd.medSystem) LIKE '%rxnorm%' THEN CAST(iwd.code AS STRING)
      ELSE NULL
    END AS RXCUI
  FROM intermediateWithDosage iwd
)

SELECT
  userId.id AS person_source_value,
  recordId AS record_source_id,

  COALESCE(SAFE_CAST(start AS DATE), SAFE_CAST(authoredOn AS DATE))    AS drug_exposure_start_DATE,
  COALESCE(SAFE_CAST(start AS DATETIME), SAFE_CAST(authoredOn AS DATETIME)) AS drug_exposure_start_DATETIME,
  SAFE_CAST(endt AS DATE)                                              AS drug_exposure_end_DATE,
  SAFE_CAST(endt AS DATETIME)                                          AS drug_exposure_end_DATETIME,

  medSystem                                                            AS drug_source_system,
  NULL AS verbatim_end_DATE,
  NULL AS drug_type_concept_id,
  NULL AS stop_reason,
  NULL AS refills,

  doseValue AS quantity,
  CASE WHEN periodUnit = 'd' THEN period ELSE NULL END                 AS days_supply,

  instructions AS sig,
  route AS route_source_value,
  NULL AS route_concept_id,
  NULL AS lot_number,
  NULL AS provider_id,
  NULL AS visit_occurrence_id,
  NULL AS visit_detail_id,

  COALESCE(medReferenceName, text)                                     AS drug_source_value,

  -- Nota: esto es el CÓDIGO RxNorm (texto), NO el OMOP concept_id.
  RXCUI                                                                AS drug_source_concept_id,
  -- Conserva además el código de origen por si no hay RxNorm
  CAST(code AS STRING)                                                 AS drug_source_code,

  doseUnit AS dose_unit_source_value,
  visit_reference AS visit_occurrence_reference,
  category AS visit_occurrence_type,
  category AS drug_source_category,
  status   AS drug_source_status

FROM intermediateNoMapping
-- Opcional: si quieres solo filas con algún código, aplica uno de estos:
-- WHERE code IS NOT NULL
-- WHERE RXCUI IS NOT NULL
