config {
    type: "view"
}

WITH measurement_base AS(
select

p.person_source_value as person_source_value,
mv.record_source_id as record_source_id,
p.person_id as person_id,
COALESCE(concept.concept_id, 0) as measurement_concept_id,

COALESCE(
  -- 1) Direct ISO 8601 / RFC3339 style with Z or offset
  SAFE_CAST(mv.measurement_DATE AS TIMESTAMP),

  -- 2) JS Date-style string:
  --    "Tue Jan 11 2022 00:00:00 GMT-0700 (Mountain Standard Time)"
  SAFE.PARSE_TIMESTAMP(
    '%a %b %d %Y %H:%M:%S GMT%z',
    REGEXP_EXTRACT(
      mv.measurement_DATE,
      r'^[A-Za-z]{3} [A-Za-z]{3} \d{1,2} \d{4} \d{2}:\d{2}:\d{2} GMT[+-]\d{4}'
    )
  ),

  -- 3) Year-month only: "2023-06" → "2023-06-01 00:00:00"
  CASE
    WHEN REGEXP_CONTAINS(mv.measurement_DATE, r'^\d{4}-\d{2}$') THEN
      SAFE_CAST(CONCAT(mv.measurement_DATE, '-01 00:00:00') AS TIMESTAMP)
  END,

  -- 4) Year only: "2023" → "2023-01-01 00:00:00"
  CASE
    WHEN REGEXP_CONTAINS(mv.measurement_DATE, r'^\d{4}$') THEN
      SAFE_CAST(CONCAT(mv.measurement_DATE, '-01-01 00:00:00') AS TIMESTAMP)
  END
) AS measurement_ts,


null as measurement_time,
null as measurement_type_concept_id,
null as operator_concept_id,
mv.value_as_number as value_as_number,
null as value_as_concept_id,
null as unit_concept_id,
SAFE_CAST(mv.range_low AS FLOAT64) as range_low,
SAFE_CAST(mv.range_high AS FLOAT64) as range_high,
null as provider_id,
vo.visit_occurrence_id as visit_occurrence_id,
null as visit_detail_id,
mv.measurement_source_value as measurement_source_value,
null as measurement_source_concept_id,
mv.unit_source_value as unit_source_value,
mv.value_source_value as value_source_value,

mv.measurement_source_code as measurement_source_code,
mv.measurement_source_system as measurement_source_system,
mv.measurement_source_status as measurement_source_status,
mv.measurement_source_type as measurement_source_type,

mv.visit_occurrence_reference as visit_occurrence_reference,
mv.visit_occurrence_type as visit_occurrence_type

from 
${ref("measurement_valid")} mv join ${ref("person")} p on mv.person_source_value = p.person_source_value
LEFT JOIN ${ref("visit_occurrence")} vo ON mv.visit_occurrence_reference = vo.record_source_id
LEFT JOIN `healthtree-production.OMOP.Concept` concept ON
concept.concept_code = mv.measurement_source_code
AND LOWER(mv.measurement_source_system) LIKE '%' || LOWER(concept.vocabulary_id) || '%'
),

no_mapping_records AS(
    SELECT record_source_id, ARRAY_AGG(measurement_concept_id) as concept_id FROM measurement_base GROUP BY record_source_id

HAVING
  ARRAY_LENGTH(ARRAY(
    SELECT x FROM UNNEST(concept_id) AS x
    WHERE x != 0
  )) = 0
),

pre AS (

SELECT * except(measurement_concept_id), measurement_concept_id FROM measurement_base WHERE measurement_concept_id <> 0
UNION ALL
(SELECT m.* except(measurement_concept_id), c.concept_id as measurement_concept_id FROM measurement_base m JOIN `healthtree-production.dataform.concept` c ON
m.measurement_source_code = c.concept_code
WHERE measurement_concept_id = 0 AND measurement_source_code LIKE "%-%"
AND m.record_source_id NOT IN (SELECT record_source_id FROM no_mapping_records)
)
)

SELECT
  ROW_NUMBER() OVER (
    ORDER BY
      record_source_id,          -- stable key
      person_id,
      measurement_source_code,
      value_source_value
  ) AS measurement_id,
  SAFE_CAST(measurement_ts AS DATE) measurement_DATE,
  SAFE_CAST(measurement_ts AS DATETIME) measurement_DATETIME,
  pre.* EXCEPT(measurement_ts)
FROM pre

