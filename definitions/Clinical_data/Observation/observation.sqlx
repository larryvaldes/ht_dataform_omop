config {
  type: "table"
}

-- 1) Tabla base
WITH base AS (
  SELECT *
  FROM ${ref("observation_semi")}   -- ⇐ ajusta si no usas ref()
),

-- 2) Marca por par (persona, registro fuente) si existe algún mapeo ≠ 0
flagged AS (
  SELECT
    b.*,
    MAX( IF(COALESCE(b.observation_concept_id, 0) != 0, 1, 0) )
      OVER (PARTITION BY b.person_source_value, b.record_source_id) AS has_mapped_in_pair
  FROM base b
)

-- 3) Regla de filtrado:
--    - Si en el par hay algún mapeo ≠ 0 (has_mapped_in_pair = 1), solo mostramos las filas ≠ 0.
--    - Si en el par NO hay mapeos ≠ 0 (has_mapped_in_pair = 0), mostramos todo (incluidos 0).
SELECT
  * EXCEPT(has_mapped_in_pair)
FROM flagged
WHERE has_mapped_in_pair = 0
   OR COALESCE(observation_concept_id, 0) != 0