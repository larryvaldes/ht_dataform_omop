config {
    type: "view"
}

  -- wrk.lot_seeds
WITH
  seeds AS (
  SELECT
    lineId,
    userId,
    diseaseKind,
    diseaseName,
    startDate,
    endDate,
    stage,
    list_type,
    item_kind,
    item_name
  FROM
    ${ref("lot_plain")}
  WHERE
    item_kind IN ('MedicationRequest',
      'Procedure')
      -- semillas
    )
SELECT
  *
FROM
  seeds
