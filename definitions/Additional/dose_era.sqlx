config {
  type: "table"
}

SELECT *
FROM UNNEST([
  STRUCT(
    CAST(NULL AS INT64) AS dose_era_id,
    CAST(NULL AS INT64) AS person_id,
    CAST(NULL AS INT64) AS drug_concept_id,
    CAST(NULL AS DATE) AS dose_era_start_date,
    CAST(NULL AS DATE) AS dose_era_end_date,
    CAST(NULL AS FLOAT64) AS dose_value,
    CAST(NULL AS INT64) AS unit_concept_id
  )
])
WHERE FALSE
